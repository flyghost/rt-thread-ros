Import('RTT_ROOT')
Import('rtconfig')
from building import *
import os

cwd = GetCurrentDir()
group = []
src = []
path = [cwd]

# 瘦身后只保留三个 BSP 真正参与编译的驱动：drv_gpio / drv_usart / drv_sdio
# 已删除：drv_spi drv_can drv_rtc drv_tim drv_pwm drv_adc drv_dac drv_crypto drv_usbd
#         drv_usbh drv_flash/* drv_sdmmc drv_nand drv_sdram drv_lptim drv_wdt 等
# 需要哪个就用 git 从历史版本恢复该 .c/.h，并在此按原样加回 GetDepend 分支。
if GetDepend(['RT_USING_PIN']):
    src += ['drv_gpio.c']

if GetDepend(['RT_USING_SERIAL']):
    # drv_usart_v2.c 已删除；若要用 RT_USING_SERIAL_V2，先恢复该文件再改这里
    src += ['drv_usart.c']

if GetDepend(['BSP_USING_SDIO']):
    src += ['drv_sdio.c']

# drv_config.h 按 家族/xxx_config.h 的形式包含配置头，config/ 必须进 CPPPATH
path += [os.path.join(cwd, 'config')]

group = DefineGroup('Drivers', src, depend = [''], CPPPATH = path)

Return('group')
