Import('RTT_ROOT')
Import('rtconfig')
from building import *
import os

cwd = GetCurrentDir()
group = []
src = ['drv_common.c']
path = [cwd]

if not GetDepend('PKG_USING_CMSIS_CORE'):
    path += [os.path.join(cwd, 'CMSIS', 'Include')]

# 瘦身后 HAL_Drivers 只保留三个 BSP 真正参与编译的驱动（见 drivers/SConscript）：
#   drv_common.c / drv_gpio.c / drv_sdio.c / drv_usart.c
# 已删除的驱动（drv_spi/drv_can/drv_rtc/drv_tim/drv_crypto/drv_usbd/drv_flash/nano ...）
# 需要时用 git 从历史版本恢复对应目录，并在 drivers/SConscript 里加回对应的 GetDepend 分支。
#
# 这里必须传相对路径（'drivers/SConscript'），不能写 os.path.join(cwd, ...)：
# variant_dir 只对相对路径生效，绝对路径会让 .o 生成在 drivers/ 源码目录里
# （上游 components/drivers/SConscript 同样是 os.path.join(d, 'SConscript') 这种相对写法）。
group = group + SConscript('drivers/SConscript')
group = group + DefineGroup('Drivers', src, depend = [''], CPPPATH = path)

Return('group')
