# 薄入口（P1）：构建逻辑在 bsp/stm32/tools/bsp_build.py，路径契约在 bsp_paths.py。
# 三块板的 SConstruct 应保持字节一致；新增板/项目请用生成器产出，不要手抄。
import os
import sys

# 下面会 import bsp/stm32/tools/ 里的模块；关掉字节码缓存，避免源码树里出现 __pycache__
sys.dont_write_bytecode = True

# 1) 项目根：环境变量 PROJECT_ROOT 覆盖（必须存在）→ 否则从本目录向上找 .git；都不满足就报错退出。
_root = os.getenv('PROJECT_ROOT')
if _root:
    _root = os.path.abspath(_root)
    if not os.path.isdir(_root):
        sys.stderr.write('[build] PROJECT_ROOT 指向的目录不存在：%s\n' % _root)
        sys.exit(1)
else:
    _root = Dir('.').abspath
    while not os.path.exists(os.path.join(_root, '.git')):
        _parent = os.path.dirname(_root)
        if _parent == _root:
            sys.stderr.write('[build] 找不到项目根：从 %s 向上没有 .git（可设置 PROJECT_ROOT 覆盖）\n'
                             % Dir('.').abspath)
            sys.exit(1)
        _root = _parent

sys.path.insert(0, os.path.join(_root, 'bsp', 'stm32', 'tools'))
import bsp_paths      # noqa: E402
import bsp_build      # noqa: E402

# 板目录 = 本 SConstruct 所在目录；用 `-f` 时 SCons 的 Dir('.') 会等于 cwd，
# 不能用来定位，需要从 GetOption('file') 反推（SConstruct 里没有 __file__）。
_files = GetOption('file') or []
BOARD_DIR = os.path.dirname(os.path.abspath(_files[0])) if _files else Dir('.').abspath

# SCons 的顶层目录必须就是板目录：os/rt-thread/tools/building.py:379 用相对路径 'SConscript'
# 解析顶层脚本，跨目录 -f 调用会找错文件；这里提前给出明确报错，而不是让它抛 traceback。
if os.path.normcase(Dir('#').abspath) != os.path.normcase(BOARD_DIR):
    sys.stderr.write(
        '[build] 构建入口必须从板目录运行。\n'
        '        当前顶层目录（Dir("#")）：%s\n'
        '        板目录：                  %s\n'
        '        正确用法：cd <板目录> 后执行 scons，或 scons -C <板目录>\n'
        % (Dir('#').abspath, BOARD_DIR))
    sys.exit(1)

# 产物目录：out/bin/<入口目录名>（elf/map/bin 都在这里，入口目录只留源码）
_ART = bsp_paths.artifact_dir(BOARD_DIR, _root)
rtconfig = bsp_build.load_rtconfig(BOARD_DIR, artifact_dir=_ART)

try:
    P = bsp_build.resolve_paths(BOARD_DIR, _root, getattr(rtconfig, 'STM32_LIBRARY', None))
except bsp_paths.BspPathError as exc:
    bsp_paths.fail(exc, where=os.path.join(BOARD_DIR, 'SConstruct'))

RTT_ROOT = P['rtt_root']
SDK_LIB = P['libraries_dir']
env = bsp_build.make_env(rtconfig)

sys.path = sys.path + [os.path.join(RTT_ROOT, 'tools')]
from building import *          # noqa: E402,F401,F403

TARGET = os.path.join(P['artifact_dir'], 'rt-thread.' + rtconfig.TARGET_EXT)
Export('RTT_ROOT')
Export('rtconfig')
Export('SDK_LIB')

# 2) 中间文件目录显式注入（os/rt-thread/tools/building.py 读 RT_BUILD_DIR）
os.environ['RT_BUILD_DIR'] = P['build_dir_rel']
# os/rt-thread/tools/building.py 会自己 `import rtconfig`（从 cwd 找），那份模块
# 也要知道产物目录，否则 POST_ACTION 的 objcopy 仍会写到入口目录。
os.environ['RT_ARTIFACT_DIR'] = P['artifact_dir']

# 构建签名库也收进中间文件目录，不再写进入口目录
SConsignFile(os.path.join(P['build_dir'], '.sconsign.dblite'))

objs = PrepareBuilding(env, RTT_ROOT, has_libcpu=False)

# 3) HAL 库 + 驱动 + 自有代码（libraries 在板目录上一级，app 在仓库根）
rtconfig.BSP_LIBRARY_TYPE = rtconfig.STM32_LIBRARY
objs.extend(SConscript(os.path.join(SDK_LIB, rtconfig.STM32_LIBRARY, 'SConscript'),
                       variant_dir=os.path.join(P['build_dir_rel'], 'libraries', rtconfig.STM32_LIBRARY),
                       duplicate=0))
objs.extend(SConscript(os.path.join(SDK_LIB, 'HAL_Drivers', 'SConscript'),
                       variant_dir=os.path.join(P['build_dir_rel'], 'libraries', 'HAL_Drivers'),
                       duplicate=0))
objs.extend(SConscript(os.path.join(P['app_root'], 'SConscript'),
                       variant_dir=os.path.join(P['build_dir_rel'], 'app'),
                       duplicate=0))

DoBuilding(TARGET, objs)

# TARGET 位于树外（out/bin/<入口名>），而 `scons` 的默认目标是 '.'（顶层目录），
# 不含树外文件；显式声明默认目标，否则只编 .o 不链接。
Default(TARGET)
