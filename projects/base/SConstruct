# 项目薄入口：只做「找仓库根 → 读 project.toml → 交给共享逻辑 → 交给 RT-Thread 上游」。
# 真正的路径契约在 bsp/stm32/tools/bsp_paths.py，构建逻辑在 bsp/stm32/tools/bsp_build.py。
import os
import sys

# SConstruct 里没有 __file__；SCons 的顶层目录就是本项目目录
PROJECT_DIR = Dir('#').abspath


def _repo_root():
    root = os.environ.get('PROJECT_ROOT')
    if root:
        return root
    d = PROJECT_DIR
    while True:
        if os.path.exists(os.path.join(d, '.git')) or os.path.exists(os.path.join(d, 'AGENTS.md')):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            print('错误：向上未找到 .git / AGENTS.md，无法确定仓库根目录；请设置 PROJECT_ROOT 环境变量')
            sys.exit(1)
        d = parent


PROJECT_ROOT = _repo_root()
sys.path.insert(0, os.path.join(PROJECT_ROOT, 'bsp', 'stm32', 'tools'))

import bsp_build
import bsp_paths

PROJECT_DIR = Dir('#').abspath
_WHERE = os.path.join(PROJECT_DIR, 'SConstruct')

if os.path.normcase(os.getcwd()) != os.path.normcase(PROJECT_DIR):
    print('错误：SCons 的工作目录不是项目目录。')
    print('  期待（项目目录）：%s' % PROJECT_DIR)
    print('  实际（cwd）：%s' % os.getcwd())
    print('  修法：进入项目目录后用 scons，或 scons -C <项目目录>；不要用 -f 指向别处的 SConstruct。')
    sys.exit(1)

try:
    META = bsp_build.load_project(PROJECT_DIR)
    BOARD_DIR = os.path.join(PROJECT_ROOT, 'bsp', 'stm32', META['board'])
    rtconfig = bsp_build.load_rtconfig(PROJECT_DIR)
    P = bsp_build.resolve_paths(PROJECT_DIR, PROJECT_ROOT, rtconfig.STM32_LIBRARY,
                                board_dir=BOARD_DIR)
except bsp_paths.BspPathError as _exc:
    bsp_paths.fail(_exc, where=_WHERE)

RTT_ROOT = P['rtt_root']
SDK_LIB = P['libraries_dir']
env = bsp_build.make_env(rtconfig)

sys.path += [os.path.join(RTT_ROOT, 'tools')]
try:
    from building import *
except Exception as _exc:  # noqa: BLE001 - 任何导入失败都要给出可读信息
    bsp_paths.fail(RuntimeError('无法从 %s 导入 RT-Thread 的 building.py：%r' % (RTT_ROOT, _exc)),
                   where=_WHERE)

TARGET = os.path.join(PROJECT_DIR, META.get('target', 'rt-thread') + '.' + rtconfig.TARGET_EXT)

Export('RTT_ROOT')
Export('rtconfig')
Export('SDK_LIB')
Export('BOARD_DIR')

# 中间文件目录：项目自己的 out/build/<project>（相对项目目录传给上游 building.py）
os.environ['RT_BUILD_DIR'] = P['build_dir_rel']

objs = PrepareBuilding(env, RTT_ROOT, has_libcpu=False)

rtconfig.BSP_LIBRARY_TYPE = rtconfig.STM32_LIBRARY
_V = P['build_dir_rel']
objs.extend(SConscript(os.path.join(SDK_LIB, rtconfig.STM32_LIBRARY, 'SConscript'),
                       variant_dir=os.path.join(_V, 'libraries', rtconfig.STM32_LIBRARY), duplicate=0))
objs.extend(SConscript(os.path.join(SDK_LIB, 'HAL_Drivers', 'SConscript'),
                       variant_dir=os.path.join(_V, 'libraries', 'HAL_Drivers'), duplicate=0))
objs.extend(SConscript(os.path.join(P['app_root'], 'SConscript'),
                       variant_dir=os.path.join(_V, 'app'), duplicate=0))

DoBuilding(TARGET, objs)
