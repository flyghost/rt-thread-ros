# components/ramdump/SConscript
from building import *

cwd  = GetCurrentDir()
path = [cwd, cwd + '/include']
src  = []

if GetDepend('RT_USING_RAMDUMP'):
    # Port adapter layer (OS abstraction)
    path += [cwd + '/port/rtthread']
    src  += ['port/rtthread/ramdump_port_rtthread.c']

    # Transport layer (selection + channels)
    path += [cwd + '/transport/uart']
    src  += [
        'transport/transport.c',
        'transport/uart/ramdump_uart.c',
    ]

    # Protocol layer
    path += [cwd + '/protocol/ymodem']
    src += [
        'protocol/protocol.c',
        'protocol/ymodem/ramdump_ymodem.c',
    ]

    # Core files
    src += [
        'ramdump_init.c',
        'ramdump_exception.c',
        'ramdump_assert.c',
        'ramdump_utils.c',
        'ramdump_commands.c',
        'ramdump_cli.c',
    ]

    if GetDepend('RAMDUMP_ENABLE_STORAGE'):
        src += [
            'ramdump_storage.c',
            'port/rtthread/ramdump_port_storage.c',
        ]

    # USB CDC ACM channel（只编 ramdump 自己的通道；栈本体在 app/usb/cherryusb）
    if GetDepend('RT_USING_RAMDUMP_USB'):
        path += [cwd + '/transport/usb']

        # 栈由 app/usb/cherryusb 的 group 提供，但本组先于它定义，
        # 所以要自己把这几个头目录挂上（顺序与上游目录一致）
        cherryusb = cwd + '/../usb/cherryusb'
        path += [cherryusb,
                 cherryusb + '/common',
                 cherryusb + '/core',
                 cherryusb + '/class/cdc',
                 cherryusb + '/port/dwc2']

        src += ['transport/usb/ramdump_usb_cdc.c']

group = DefineGroup('ramdump', src, depend=['RT_USING_RAMDUMP'],
                    CPPPATH=path)

Return('group')
